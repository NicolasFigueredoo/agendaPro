APP_NAME="Centro de Estética"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=turnos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=turnos

# Mail (ejemplo con SMTP; en local podés usar MAIL_MAILER=log o Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="turnos@tucentro.com.ar"
MAIL_FROM_NAME="${APP_NAME}"

# Usuario admin inicial (lo usa el seeder)
ADMIN_EMAIL=admin@centro.test
ADMIN_PASSWORD=password

# Mercado Pago
# Las credenciales se cargan desde Configuración → Mercado Pago y se guardan
# encriptadas en la tabla settings. Estas variables son solo valores iniciales opcionales.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
# URL pública para el webhook en local (ngrok / cloudflared). Si está vacía usa APP_URL.
MERCADOPAGO_WEBHOOK_BASE_URL=

VITE_APP_NAME="${APP_NAME}"
